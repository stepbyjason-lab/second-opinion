# second-opinion — API 어댑터용 키 템플릿
#
# 사용법: 이 파일을 .env.local 로 복사하고 값을 채운다.
#   cp .env.local.sample .env.local
#
# .env.local 은 .gitignore 로 추적에서 제외된다(이 .sample 만 커밋된다).
# 값을 이 파일에 직접 쓰지 말 것 — 여기는 템플릿이다.
#
# CLI 어댑터(codex·agy·claude)는 각 CLI가 자체 인증을 쓰므로 키가 필요 없다.
# 아래는 `--request-json` 생성 경로의 **API transport** 어댑터에만 해당한다.
#
# 디스패처는 이 파일을 스스로 읽지 않는다. 요청 JSON의 `env_file` 로 경로를
# 넘기면 그때 읽는다. 키 "값"은 argv·영수증·로그·에러 어디에도 실리지 않으며
# 어댑터는 변수 "이름"만 선언한다.
#
# 필요한 provider만 채우면 된다. 키가 없는 provider는 그 provider를 지목했을 때
# `auth-failed`/`user` 로 실패하고, 다른 provider로 넘어가지 않는다(설계상 폴백 없음).

# ─────────────────────────────────────────────────────────────────────
# OpenAI 호환 provider — 요청 본문 형식이 같고 base URL만 다르다
# ─────────────────────────────────────────────────────────────────────

# --- OpenRouter --------------------------------------------------------
# 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# base URL 재정의(선택). 해당 provider의 신뢰 origin만 허용된다.
# 기본값: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- NVIDIA NIM --------------------------------------------------------
# 발급: https://build.nvidia.com/ → API Key
# 주의: NIM 카탈로그는 모델이 예고 없이 내려간다(폐기 시 HTTP 410).
NVIDIA_NIM_API_KEY=
# 기본값: https://integrate.api.nvidia.com/v1
NVIDIA_NIM_BASE_URL=

# --- Mistral -----------------------------------------------------------
# 발급: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# 기본값: https://api.mistral.ai/v1
MISTRAL_BASE_URL=

# --- GitHub Models -----------------------------------------------------
# 발급: GitHub → Settings → Developer settings → Personal access tokens
#       (models:read 권한)
GITHUB_MODELS_API_KEY=
# 기본값: https://models.github.ai/inference
GITHUB_MODELS_BASE_URL=

# --- Zhipu (Z.ai / GLM) ------------------------------------------------
# 발급: https://z.ai/ → API Keys
ZHIPU_API_KEY=
# 기본값: https://api.z.ai/api/paas/v4
ZHIPU_BASE_URL=

# ─────────────────────────────────────────────────────────────────────
# Gemini — 요청 본문 형식이 다른 별도 어댑터
# ─────────────────────────────────────────────────────────────────────

# --- Gemini (Google AI Studio) -----------------------------------------
# 발급: https://aistudio.google.com/apikey
# 인증: x-goog-api-key 헤더 (URL 쿼리 ?key= 사용 금지)
GEMINI_API_KEY=
# 기본값: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=

# ─────────────────────────────────────────────────────────────────────
# 생성 경로 밖 — 이미지 어댑터용
# ─────────────────────────────────────────────────────────────────────

# --- Magnific (구 Freepik) ---------------------------------------------
# 발급: Magnific 대시보드 → API/Developers
# 인증: x-magnific-api-key 헤더 (server-to-server 전용)
#
# ⚠️ 비용 주의: 웹 구독과 API가 같은 크레딧 풀을 쓴다. 단 Premium+ 의
#    "Unlimited" 혜택은 웹앱 안에서만 유효하고, API 호출은 예외 없이
#    크레딧을 차감한다. 영상 생성은 이미지보다 단가가 크다.
MAGNIFIC_API_KEY=
